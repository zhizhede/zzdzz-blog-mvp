# ─────────────── IDE / Editor ───────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ─────────────── Go ───────────────
server/bin/
server/server.exe
server/server
*.test
*.out
coverage.out
coverage.html

# ─────────────── Node / Vue ───────────────
web/node_modules/
web/dist/
web/.vite/
web/.cache/
web/.env
web/.env.local
web/*.local

# ─────────────── Logs ───────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─────────────── Secrets / Config ───────────────
# 不要把数据库密码 / API key 之类的本地配置提交
**/.env
!**/.env.example
**/config.local.yaml
**/config.local.yml
# 本地 SSH 私钥 (按服务器命名)
keys/
**/keys/
# 生产/预发环境的真实配置不进仓库 (本地可保留,服务器另传)
server/config/*.production.yaml
server/config/*.staging.yaml
**/*.production.yaml
**/*.staging.yaml

# ─────────────── Build artifacts ───────────────
web/src/assets/
*.tsbuildinfo
# 部署产物 (二进制 + dist),只在本地 staging 用,不入库
deploy/release/blog-server/blog-server
deploy/release/blog-server/web/