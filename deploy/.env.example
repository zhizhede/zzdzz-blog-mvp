# zzdzz-blog 部署环境变量模板
# 复制为 .env 并填入真实值,本文件不提交 git

# ──── 数据库 ────
PG_USER=postgres
PG_PASSWORD=CHANGE_ME_STRONG_PASSWORD
PG_DB=zzdzz_blog

# ──── JWT ────
# 生成: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_RANDOM_32_BYTES_HEX

# ──── AI (OpenAI 兼容) ────
AI_BASE_URL=https://api.minimaxi.com/v1
AI_API_KEY=sk-cp-YOUR_KEY_HERE
AI_MODEL=MiniMax-M3
AI_ENABLED=true

# ──── 前端端口 ────
HTTP_PORT=80